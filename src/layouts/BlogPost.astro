---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, author, image, tags } = Astro.props;
---

<BaseLayout title={`${title} — Asher's Bees`} description={description}>

  <!-- Reading progress bar: thin gold line that fills as you scroll -->
  <div id="reading-progress" aria-hidden="true"></div>

  <article class="blog-post">

    <!-- Hero image -->
    {image && (
      <div class="post-hero">
        <img
          src={image.src}
          alt={image.alt}
          class="post-hero-img"
          loading="eager"
        />
      </div>
    )}

    <!-- Post header -->
    <header class="post-header">
      <div class="container">
        <div class="post-meta">
          <time class="post-date"><FormattedDate date={pubDate} /></time>
          {tags.length > 0 && (
            <ul class="post-tags" role="list">
              {tags.map(tag => <li class="post-tag">{tag}</li>)}
            </ul>
          )}
        </div>
        <h1 class="post-title">{title}</h1>
        <p class="post-author">By {author}</p>
      </div>
    </header>

    <!-- Post content — dark background throughout, light text -->
    <div class="post-content">
      <div class="container--prose prose">
        <slot />
      </div>
    </div>

    <!-- Back link -->
    <div class="post-back">
      <div class="container">
        <a href="/blog" class="back-link">
          <svg width="14" height="9" viewBox="0 0 16 10" fill="none" aria-hidden="true">
            <path d="M16 5H2M6 1L2 5l4 4" stroke="currentColor" stroke-width="1.3"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          All posts
        </a>
      </div>
    </div>

  </article>

</BaseLayout>


<style>

  /* ── Reading progress bar ─────────────────────────────────────────────── */

  #reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent) 0%, rgba(212, 160, 48, 0.6) 100%);
    z-index: calc(var(--z-overlay) + 10);
    pointer-events: none;
  }


  /* ── Overall dark page ────────────────────────────────────────────────── */

  .blog-post {
    background-color: var(--color-bg);
    min-height: 100vh;
  }


  /* ── Hero image ───────────────────────────────────────────────────────── */

  .post-hero {
    width: 100%;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    /* GSAP will animate this to opacity 1 on load */
    opacity: 0;
  }

  .post-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }


  /* ── Post header ──────────────────────────────────────────────────────── */

  .post-header {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-sm);
    /* GSAP will animate this in on load */
    opacity: 0;
  }

  .post-date {
    font-family: var(--font-body);
    font-size: var(--text-body-xs);
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-tag {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-green);
    padding: 2px 9px;
    border: 1px solid rgba(0, 108, 50, 0.3);
    border-radius: var(--radius-full);
    margin-bottom: 0;
  }

  .post-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: var(--font-weight-heading-bold);
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--color-text-on-dark);
    margin: 0 0 var(--space-xs);
    max-width: var(--prose-width);
    font-feature-settings: 'liga' 1;
    /* GSAP will animate this in on load */
    opacity: 0;
  }

  .post-author {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
    margin: 0;
    letter-spacing: 0.02em;
    /* GSAP will animate this in on load */
    opacity: 0;
  }


  /* ── Post content — dark background, all light text ──────────────────── */

  .post-content {
    padding-block: var(--space-lg);
    background-color: var(--color-bg);
  }

  .container--prose {
    max-width: var(--prose-width);
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  /*
   * The prose content inherits light text from body (--color-text-on-dark).
   * We only need targeted overrides for elements that would otherwise pull
   * in surface/light-mode colours from design-system.css.
   */

  /* Links in dark context: gold accent */
  :global(.post-content .prose a) {
    color: var(--color-accent);
  }
  :global(.post-content .prose a:hover) {
    color: var(--color-accent-dark);
  }

  /* Dividers: subtle on dark bg */
  :global(.post-content .prose hr) {
    border-color: rgba(255, 255, 255, 0.08);
  }

  /* Inline code: dark-friendly */
  :global(.post-content .prose code) {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
    color: var(--color-text-on-dark);
  }

  /* Code blocks: dark-friendly border */
  :global(.post-content .prose pre) {
    border-color: rgba(255, 255, 255, 0.06);
  }


  /* ── Back navigation ──────────────────────────────────────────────────── */

  .post-back {
    padding-block: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(237, 236, 232, 0.35);
    text-decoration: none;
    transition: color 200ms, gap 200ms;
  }

  .back-link:hover {
    color: var(--color-text-on-dark);
    gap: 11px;
  }


  /* ── Responsive ───────────────────────────────────────────────────────── */

  @media (max-width: 768px) {
    .container--prose { padding-inline: var(--space-sm); }
    .post-header      { padding-top: var(--space-md); }
  }

</style>


<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);


  // ── Reading progress bar ───────────────────────────────────────────────
  const progressBar = document.getElementById('reading-progress') as HTMLElement | null;
  if (progressBar) {
    const updateProgress = () => {
      const scrollTop    = document.documentElement.scrollTop;
      const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      progressBar.style.width = scrollHeight > 0 ? `${(scrollTop / scrollHeight) * 100}%` : '0%';
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }


  // ── Page-load entrance: hero + header ─────────────────────────────────
  const hero   = document.querySelector<HTMLElement>('.post-hero');
  const meta   = document.querySelector<HTMLElement>('.post-meta');
  const title  = document.querySelector<HTMLElement>('.post-title');
  const author = document.querySelector<HTMLElement>('.post-author');

  // Set the y-offset starting positions for the slide-in effect
  if (meta)   gsap.set(meta,   { y: 20 });
  if (title)  gsap.set(title,  { y: 32 });
  if (author) gsap.set(author, { y: 16 });

  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

  // Hero image fades in first (opacity already 0 via CSS)
  if (hero) {
    tl.to(hero, { opacity: 1, duration: 1.1, ease: 'power2.inOut' }, 0);
  }

  // Header elements stagger in after hero starts
  const hStart = hero ? 0.22 : 0;
  if (meta)   tl.to(meta,   { opacity: 1, y: 0, duration: 0.65 }, hStart);
  if (title)  tl.to(title,  { opacity: 1, y: 0, duration: 0.75 }, '<0.1');
  if (author) tl.to(author, { opacity: 1, y: 0, duration: 0.55 }, '<0.12');


  // ── Scroll-triggered prose animations ─────────────────────────────────

  // Paragraphs — fade + slide up, batched with stagger so adjacent
  // paragraphs animate sequentially when they enter together
  ScrollTrigger.batch('.post-content .prose > p', {
    onEnter: (batch) =>
      gsap.fromTo(
        batch,
        { opacity: 0, y: 26 },
        { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out', stagger: 0.1, overwrite: true }
      ),
    once:  true,
    start: 'top 92%',
  });

  // Headings (h2, h3, h4) — slide in from the left
  document.querySelectorAll<HTMLElement>(
    '.post-content .prose h2, .post-content .prose h3, .post-content .prose h4'
  ).forEach(el => {
    gsap.set(el, { opacity: 0, x: -32 });
    ScrollTrigger.create({
      trigger: el,
      start:   'top 90%',
      once:    true,
      onEnter: () => gsap.to(el, { opacity: 1, x: 0, duration: 0.65, ease: 'power2.out' }),
    });
  });

  // Blockquotes — fade in with a subtle scale-up
  document.querySelectorAll<HTMLElement>('.post-content .prose blockquote').forEach(el => {
    gsap.set(el, { opacity: 0, scale: 0.97, transformOrigin: 'left center' });
    ScrollTrigger.create({
      trigger: el,
      start:   'top 90%',
      once:    true,
      onEnter: () => gsap.to(el, { opacity: 1, scale: 1, duration: 0.8, ease: 'power2.out' }),
    });
  });

  // Images — fade + scale up from slightly smaller
  document.querySelectorAll<HTMLElement>('.post-content .prose img').forEach(el => {
    gsap.set(el, { opacity: 0, scale: 0.95, transformOrigin: 'center bottom' });
    ScrollTrigger.create({
      trigger: el,
      start:   'top 92%',
      once:    true,
      onEnter: () => gsap.to(el, { opacity: 1, scale: 1, duration: 0.9, ease: 'power2.out' }),
    });
  });
</script>
