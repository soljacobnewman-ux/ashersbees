---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const GRADIENTS = [
  'linear-gradient(140deg, #2A1400 0%, #7A4800 55%, #D4A030 100%)',
  'linear-gradient(140deg, #120E00 0%, #4A3A00 55%, #8A7010 100%)',
  'linear-gradient(140deg, #060F0A 0%, #1E3A20 55%, #406030 100%)',
  'linear-gradient(140deg, #10080F 0%, #3A1828 55%, #6A3048 100%)',
  'linear-gradient(140deg, #060A10 0%, #162040 55%, #284870 100%)',
  'linear-gradient(140deg, #0A0800 0%, #302400 55%, #685010 100%)',
] as const;
---

<BaseLayout
  title="The Blog — Asher's Bees"
  description="Beekeeping notes and seasonal updates from Turtle Bay Gardens, Manhattan."
>

  <!-- ======================================================================
       PAGE HEADER
       Large Cormorant italic heading, short italic subtitle.
       A thin gradient rule anchors the section bottom.
       ====================================================================== -->
  <header class="page-header">
    <div class="container">
      <div class="page-header-inner slide-up">
        <p class="page-eyebrow text-label">Archive</p>
        <h1 class="page-title">The Blog</h1>
        <p class="page-subtitle">Seasonal notes from the rooftop.</p>
      </div>
    </div>
    <div class="page-rule" aria-hidden="true"></div>
  </header>


  <!-- ======================================================================
       POST GRID
       3 columns → 2 → 1. Each card staggered by its index.
       Cards are deliberately understated so the Cormorant titles dominate.
       ====================================================================== -->
  <main class="blog-main">
    <div class="container">

      {posts.length > 0 ? (

        <ul class="post-grid" role="list">
          {posts.map((post, index) => {
            const gradient = GRADIENTS[index % GRADIENTS.length];
            const delay    = Math.min(index * 80, 320);
            return (
              <li
                class="post-card slide-up"
                style={`transition-delay: ${delay}ms`}
              >

                <!-- Image / placeholder -->
                <a href={`/blog/${post.id}/`} class="card-img-link" tabindex="-1" aria-hidden="true">
                  {post.data.image ? (
                    <img
                      src={post.data.image.src}
                      alt={post.data.image.alt}
                      class="card-img"
                      loading={index < 3 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  ) : (
                    <div
                      class="card-img-placeholder"
                      style={`background: ${gradient}`}
                      aria-hidden="true"
                    >
                      <svg viewBox="0 0 60 70" fill="none" class="placeholder-mark" aria-hidden="true">
                        <path d="M30 3L57 18V52L30 67L3 52V18L30 3Z"
                              stroke="white" stroke-width="0.7" opacity="0.18"/>
                        <path d="M30 18L45 26.5V43.5L30 52L15 43.5V26.5L30 18Z"
                              stroke="white" stroke-width="0.5" opacity="0.1"/>
                      </svg>
                    </div>
                  )}
                </a>

                <!-- Card body -->
                <div class="card-body">

                  <!-- Date -->
                  <time class="card-date">
                    <FormattedDate date={post.data.pubDate} />
                  </time>

                  <!-- Title -->
                  <h2 class="card-title">
                    <a href={`/blog/${post.id}/`} class="card-title-link">
                      {post.data.title}
                    </a>
                  </h2>

                  <!-- Description -->
                  <p class="card-desc">{post.data.description}</p>

                  <!-- Tags row -->
                  {post.data.tags.length > 0 && (
                    <ul class="card-tags" role="list" aria-label="Post tags">
                      {post.data.tags.map(tag => (
                        <li class="card-tag">{tag}</li>
                      ))}
                    </ul>
                  )}

                  <!-- CTA arrow -->
                  <a
                    href={`/blog/${post.id}/`}
                    class="card-cta"
                    aria-label={`Read ${post.data.title}`}
                  >
                    Read
                    <svg width="14" height="9" viewBox="0 0 16 10" fill="none" aria-hidden="true">
                      <path d="M0 5h14M10 1l4 4-4 4"
                            stroke="currentColor" stroke-width="1.3"
                            stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>

                </div>
              </li>
            );
          })}
        </ul>

      ) : (

        <div class="empty-state fade-in">
          <svg viewBox="0 0 80 92" fill="none" class="empty-hex" aria-hidden="true">
            <path d="M40 4L76 24V68L40 88L4 68V24L40 4Z"
                  stroke="#006C32" stroke-width="1" opacity="0.35"/>
            <path d="M40 22L62 34V58L40 70L18 58V34L40 22Z"
                  stroke="#006C32" stroke-width="0.75" opacity="0.2"/>
          </svg>
          <p class="empty-line1">First post coming soon.</p>
          <p class="empty-line2">The bees are busy.</p>
        </div>

      )}

    </div>
  </main>

</BaseLayout>


<style>

  /* ─── PAGE HEADER ───────────────────────────────────────────────────────── */

  .page-header {
    position: relative;
    background-color: var(--color-bg);
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
  }

  .page-header-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .page-eyebrow {
    color: var(--color-green);
    letter-spacing: 0.2em;
  }

  .page-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: var(--font-weight-heading-bold);
    font-size: clamp(3.5rem, 10vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: var(--color-text-on-dark);
    margin: 0;
    font-feature-settings: 'liga' 1, 'kern' 1;
  }

  .page-subtitle {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: var(--font-weight-heading-regular);
    font-size: clamp(1rem, 2.2vw, 1.4rem);
    color: rgba(237, 236, 232, 0.35);
    line-height: 1.5;
    margin: var(--space-xs) 0 0;
    max-width: 38ch;
  }

  .page-rule {
    position: absolute;
    bottom: 0;
    left: var(--space-md);
    right: 0;
    height: 1px;
    background: linear-gradient(90deg,
      var(--color-green) 0%,
      rgba(0, 108, 50, 0.2) 30%,
      transparent 65%);
    opacity: 0.5;
  }


  /* ─── BLOG MAIN ─────────────────────────────────────────────────────────── */

  .blog-main {
    background-color: var(--color-bg);
    padding-top: var(--space-lg);
    padding-bottom: var(--space-xl);
  }


  /* ─── POST GRID ─────────────────────────────────────────────────────────── */

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }


  /* ─── POST CARD ─────────────────────────────────────────────────────────── */

  .post-card {
    display: flex;
    flex-direction: column;
    background-color: #0D0D0D;
    border: 1px solid rgba(255, 255, 255, 0.045);
    border-radius: 0;
    overflow: hidden;
    transition:
      transform    560ms var(--ease-out),
      box-shadow   560ms var(--ease-out),
      border-color 560ms var(--ease-out);
    /* Reset li spacing */
    margin-bottom: 0;
  }

  .post-card:hover {
    transform: scale(1.02);
    box-shadow: 0 20px 56px rgba(0, 0, 0, 0.5);
    border-color: rgba(0, 108, 50, 0.2);
  }

  /* ── Image ──────────────────────────────────────────────────────────────── */

  .card-img-link {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    flex-shrink: 0;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform 700ms var(--ease-out);
  }

  .card-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 700ms var(--ease-out);
  }

  .post-card:hover .card-img,
  .post-card:hover .card-img-placeholder {
    transform: scale(1.05);
  }

  .placeholder-mark {
    width: 44px;
    height: auto;
    flex-shrink: 0;
  }

  /* ── Card body ──────────────────────────────────────────────────────────── */

  .card-body {
    padding: var(--space-sm) var(--space-md) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .card-date {
    font-family: var(--font-body);
    font-size: var(--text-body-xs);
    letter-spacing: 0.07em;
    color: var(--color-text-muted);
  }

  .card-title {
    font-family: var(--font-heading);
    font-style: normal;
    font-weight: var(--font-weight-heading-bold);
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-text-on-dark);
    margin: 0;
    font-feature-settings: 'liga' 1;
  }

  .card-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 280ms;
  }

  .card-title-link:hover {
    color: var(--color-green);
  }

  .card-desc {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    color: rgba(237, 236, 232, 0.38);
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tags — no pill boxes, just small spaced text */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card-tag {
    font-family: var(--font-body);
    font-size: var(--text-body-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(0, 108, 50, 0.8);
    margin-bottom: 0;

    /* Dot separator between tags */
    &:not(:last-child)::after {
      content: ' · ';
      opacity: 0.5;
    }
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 10px;
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: var(--font-weight-body-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-green);
    text-decoration: none;
    transition: gap 280ms, color 280ms;
  }

  .card-cta:hover {
    gap: 10px;
    color: var(--color-green-dark);
  }


  /* ─── EMPTY STATE ───────────────────────────────────────────────────────── */

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding-block: var(--space-xl);
    text-align: center;
  }

  .empty-hex {
    width: 64px;
    height: auto;
  }

  .empty-line1 {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--text-h4);
    color: rgba(237, 236, 232, 0.4);
    margin: 0;
  }

  .empty-line2 {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--text-h4);
    color: var(--color-green);
    margin: 0;
  }


  /* ─── RESPONSIVE ────────────────────────────────────────────────────────── */

  @media (max-width: 1024px) {
    .post-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .page-header  { padding-top: var(--space-lg); }
    .page-rule    { left: var(--space-sm); }
    .post-grid    { grid-template-columns: 1fr; gap: var(--space-sm); }
    .card-body    { padding: var(--space-sm); }

    .post-card:hover { transform: none; }

    .break-sm { display: none; }
  }

</style>
